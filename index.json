  "plugins": [
    {
      "name": "dsh-boot-resume",
      "title": {
        "en": "Auto Continue (resume after restart)",
        "zh": "重启后自动续跑"
      },
      "description": {
        "en": "When the DSH host restarts mid-turn, the open turn is closed as 'interrupted' and the conversation waits for you. This plugin runs one check per boot: it reads each workspace session's tail, finds the turn that never finished (open turn/start, or turn/end with reason 'interrupted'), and resumes it with a short follow-up so the work continues by itself. Cooldown and a daily cap stop a crash loop.",
        "zh": "DSH 宿主在轮次中途重启时，开放轮次会被标记为 interrupted 关闭，对话就停在那里等你。这个插件每次启动做一次检查：读各 workspace 会话的日志尾部，找出没跑完的那一轮（没有 turn/end 的开放轮次，或 reason 为 interrupted 的 turn/end），自动 resume 并投一条「继续」，让工作自己接上。冷却与每日上限兜住崩溃循环。"
      },
      "icon": "data:image/svg+xml;base64,",
      "author": "monkey-sking",
      "homepage": "https://github.com/monkey-sking/dsh-boot-resume#readme",
